<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        DAY 6 — includeAll DEMO: patch file 2
        Loaded after patch-001 because 'patch-002' sorts after 'patch-001'.
    -->

    <changeSet id="w2-day6-patch002-001" author="khushal">
        <createTable tableName="coupons">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="discount_pct" type="NUMERIC(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_until" type="DATE"/>
            <column name="max_uses" type="INT"/>
            <column name="used_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="coupons"/>
        </rollback>
    </changeSet>

    <changeSet id="w2-day6-patch002-002" author="khushal">
        <addColumn tableName="orders">
            <column name="coupon_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="orders"
            baseColumnNames="coupon_id"
            constraintName="fk_orders_coupon"
            referencedTableName="coupons"
            referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="orders" constraintName="fk_orders_coupon"/>
            <dropColumn tableName="orders" columnName="coupon_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
